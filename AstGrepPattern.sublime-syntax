%YAML 1.2
---
# See http://www.sublimetext.com/docs/syntax.html
scope: source.ast-grep
hidden: true
version: 2


contexts:
  main:
    - match: (\$_)[A-Z1-9_]+
      scope: variable.non-capturing.meta
      captures:
        1: punctuation.definition.variable
    - match: (\$)[A-Z1-9_]+
      scope: variable.single.meta
      captures:
        1: punctuation.definition.variable
    - match: (\$\$)[A-Z1-9_]+
      scope: variable.unnamed.meta
      captures:
        1: punctuation.definition.variable
    - match: (\$\$\$)[A-Z1-9_]+
      scope: variable.multi.meta
      captures:
        1: punctuation.definition.variable
